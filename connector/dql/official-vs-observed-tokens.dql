// Official daily tokens (layer 3, bizevents) vs real-time observed tokens (layer 2, Claude Code OTel logs,
// event.name == "api_request") per developer per UTC day, last 7 days.
// Layer 2 attribute names follow the Claude Code OTel log export: user.email, model, input_tokens, output_tokens,
// cache_read_tokens, cache_creation_tokens, cost_usd. Adjust the right side if layer 2 renames them.
// Expect observed <= official for claude_code: hooks only see sessions that ran on instrumented machines,
// and the official number also covers claude.ai Claude Code on the web.
fetch bizevents, from: now() - 10d
| filter event.type == "claude.usage.daily" and product == "claude_code"
| filter usage.date >= formatTimestamp(now() - 7d, format: "yyyy-MM-dd")
| dedup dedup.key, sort: {timestamp desc}
| summarize {
    official_tokens = sum(tokens.total),
    official_cost_usd = sum(cost_usd)
  }, by: {user.email, usage.date}
| join [
    fetch logs, from: now() - 7d
    | filter event.name == "api_request"
    | fieldsAdd usage.date = formatTimestamp(timestamp, format: "yyyy-MM-dd")
    | summarize {
        observed_tokens = sum(toLong(input_tokens) + toLong(output_tokens) + toLong(cache_read_tokens) + toLong(cache_creation_tokens)),
        observed_cost_usd = sum(toDouble(cost_usd)),
        api_requests = count()
      }, by: {user.email, usage.date}
  ], on: {user.email, usage.date}, kind: outer, prefix: "obs."
| fieldsAdd observed_tokens = coalesce(obs.observed_tokens, 0), observed_cost_usd = coalesce(obs.observed_cost_usd, 0.0)
| fieldsAdd coverage_pct = if(official_tokens > 0, observed_tokens * 100.0 / official_tokens, else: 0)
| fieldsAdd delta_usd = coalesce(official_cost_usd, 0.0) - observed_cost_usd
| fields usage.date, user.email, official_tokens, observed_tokens, coverage_pct, official_cost_usd, observed_cost_usd, delta_usd, api_requests = obs.api_requests
| sort usage.date desc, delta_usd desc
